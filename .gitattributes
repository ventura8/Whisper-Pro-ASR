# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and checked out
# with LF line endings
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ps1 text eol=lf

# Audio fixtures are binary; never let the text=auto heuristic touch them.
*.wav binary
*.flac binary
