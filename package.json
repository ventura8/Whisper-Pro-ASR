{
  "name": "whisper-pro-asr-frontend-quality",
  "version": "1.5.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "fix:md": "markdownlint-cli2 --fix",
    "lint:md": "markdownlint-cli2",
    "lint:html": "htmlhint \"modules/monitoring/templates/*.html\" && html-validate --max-warnings 0 \"modules/monitoring/templates/*.html\"",
    "lint:js": "eslint --cache --cache-location /var/cache/whisper-pro-asr-tools/eslint/lint-js.cache --max-warnings 0 --no-inline-config --report-unused-disable-directives modules/monitoring/templates/**/*.js tests/js/**/*.js",
    "lint:js:complexity": "eslint --cache --cache-location /var/cache/whisper-pro-asr-tools/eslint/lint-js-complexity.cache --max-warnings 0 --no-inline-config --report-unused-disable-directives modules/monitoring/templates/dashboard/**/*.js modules/monitoring/templates/analytics/**/*.js",
    "lint:css": "stylelint --cache --cache-location /var/cache/whisper-pro-asr-tools/stylelint/cache --max-warnings 0 --report-needless-disables --report-invalid-scope-disables --report-descriptionless-disables \"static/**/*.css\" \"modules/monitoring/templates/**/*.css\"",
    "lint:toml": "taplo fmt --check && taplo lint",
    "test:js": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:filters": "playwright test tests/e2e/dashboard-filters.spec.cjs",
    "test:e2e:real": "playwright test --config=playwright.real.config.cjs",
    "quality:frontend": "npm run lint:html && npm run lint:js && npm run lint:js:complexity && npm run lint:css && npm run lint:toml && npm audit --audit-level=low && npm run test:js && npm run test:e2e && npm run test:e2e:real"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "5.0.3",
    "braces": "file:vendor/npm/braces",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "htmlhint": "1.9.2",
    "jsdom": "30.1.2",
    "markdownlint-cli2": "^0.23.3",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fast-uri": "4.2.2",
    "glob": "13.0.6",
    "cosmiconfig": {
      "js-yaml": "^4.3.2"
    },
    "smol-toml": "^1.8.0",
    "katex": "0.19.0",
    "braces": "$braces"
  }
}
