# Shared dependencies and requirements for CI build and test scripts
# Deliberately the FLOOR of the supported range (pyproject: >=3.12,<3.14), not the newest.
# This container only resolves poetry.lock, and a lock resolved on the oldest interpreter the
# project supports is valid on every newer one; resolving on the newest can bake in markers
# that exclude 3.12.
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:24-slim
MIN_NODE_VERSION=22
HADOLINT_VERSION=2.15.1
PSSCRIPTANALYZER_VERSION=1.25.0
POWERSHELL_IMAGE=mcr.microsoft.com/powershell:7.5-ubuntu-22.04
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0
# Keep in sync with ARG PIP_VERSION / POETRY_VERSION in Dockerfile and Dockerfile.test
PIP_VERSION=26.2.1
POETRY_VERSION=2.4.3
