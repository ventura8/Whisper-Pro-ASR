[run]
parallel = true
source =
    modules
    whisper_pro_asr.py
omit =
    tests/*
    */tests/*
    */__pycache__/*
    scripts/*
    # Scratch the real-media runners drop at the repository root (see .gitignore): coverage
    # runs with --cov=., so a probe in flight put its helper script in coverage.xml at 0%
    # and failed the per-file threshold on a file that is not source. Anchored to the root:
    # a bare `_*` also omitted every `__init__.py`, the scheduler's 319 statements included.
    ./_*


[report]
# Deliberately no fail_under here: pytest-cov reads this value independently of
# pytest.ini's own --cov-fail-under and would otherwise fail each partial
# invocation once the pytest run is split into bulk (-n auto) + serial
# (timing-sensitive concurrency tests) runs sharing one combined coverage.xml.
# The 90% gate is enforced exactly once, explicitly, via `coverage report
# --fail-under=90` in tests/run_suite.sh after `coverage combine`.
show_missing = true
exclude_lines =
    pragma: no cover
    raise NotImplementedError
